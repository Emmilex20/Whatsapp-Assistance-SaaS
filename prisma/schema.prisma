generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum AutomationStatus {
  ACTIVE
  DRAFT
  PAUSED
}

enum SenderType {
  CUSTOMER
  BOT
  HUMAN
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PilotStatus {
  NEW
  CONTACTED
  SETUP_IN_PROGRESS
  LIVE_TESTING
  ACTIVE
  NOT_INTERESTED
}

enum PilotTestStatus {
  NOT_STARTED
  IN_PROGRESS
  PASSED
  FAILED
}

enum TeamRole {
  OWNER
  MANAGER
  AGENT
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ConversationWorkflowStatus {
  OPEN
  PENDING
  RESOLVED
}

enum AIEventType {
  SUGGESTION
  AUTO_REPLY
  BLOCKED_AUTO_REPLY
}

enum PromoCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReportArchiveType {
  WEEKLY
  MONTHLY
}

model User {
  id                 String   @id @default(cuid())
  clerkId            String   @unique
  email              String   @unique
  name               String?
  activeRestaurantId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  restaurants Restaurant[]
}

model Restaurant {
  id                    String   @id @default(cuid())
  ownerId               String
  name                  String
  whatsappNumber        String?
  whatsappPhoneNumberId String?
  address               String?
  openingTime           String?
  closingTime           String?
  brandPrimaryColor     String?
  brandSecondaryColor   String?
  brandSlogan           String?
  brandTone             String?
  brandLogoUrl          String?
  brandVisualStyle      String?
  aiAutoReplyEnabled    Boolean  @default(false)
  aiUpsellsEnabled      Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  menuItems     MenuItem[]
  faqs          FAQ[]
  automations   Automation[]
  conversations Conversation[]
  voiceTranscriptions VoiceTranscription[]
  deliveryZones DeliveryZone[]
  orders        Order[]
  subscription  Subscription?
  pilotClients  PilotClient[]
  teamMembers   TeamMember[]
  knowledgeBaseItems KnowledgeBaseItem[]
  customerMemories CustomerMemory[]
  customerLoyalty CustomerLoyalty[]
  aiUsageLogs AIUsageLog[]
  mediaGenerations MediaGeneration[]
  promoCampaigns PromoCampaign[]
  reportArchives ReportArchive[]
  businessInsights BusinessInsight[]
  socialAccounts SocialAccount[]
  upsellRules UpsellRule[]
  upsellAttempts UpsellAttempt[]
  complaintAlerts ComplaintAlert[]
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  category     String?
  price        Int
  available    Boolean  @default(true)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model FAQ {
  id           String   @id @default(cuid())
  restaurantId String
  question     String
  answer       String
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Automation {
  id           String           @id @default(cuid())
  restaurantId String
  name         String
  triggers     String[]
  response     String
  status       AutomationStatus @default(ACTIVE)
  usedCount    Int              @default(0)
  isDemo       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                   String   @id @default(cuid())
  restaurantId         String
  customerName         String?
  customerPhone        String
  status               String   @default("BOT_ACTIVE")
  priority             ConversationPriority @default(NORMAL)
  tags                 String[] @default([])
  workflowStatus       ConversationWorkflowStatus @default(OPEN)
  resolvedAt           DateTime?
  assignedTeamMemberId String?
  internalNotes        String?
  isDemo               Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  restaurant         Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignedTeamMember TeamMember? @relation("ConversationAssignments", fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)
  messages           Message[]
  orders             Order[]
  aiUsageLogs        AIUsageLog[]
  complaintAlerts    ComplaintAlert[]
  voiceTranscriptions VoiceTranscription[]

  @@unique([restaurantId, customerPhone])
}

model Message {
  id             String     @id @default(cuid())
  conversationId String
  senderType     SenderType
  content        String
  isDemo         Boolean    @default(false)
  createdAt      DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  voiceTranscription VoiceTranscription?
}

model VoiceTranscription {
  id              String   @id @default(cuid())
  restaurantId    String
  conversationId  String
  messageId       String?  @unique
  whatsappMediaId String
  mimeType        String?
  audioData       Bytes?
  audioSize       Int      @default(0)
  transcript      String?
  correctedText   String?
  confidence      Int      @default(0)
  language        String   @default("en-pidgin")
  status          String   @default("PENDING")
  error           String?
  audioExpiresAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([conversationId, createdAt])
  @@index([status, audioExpiresAt])
}

model Subscription {
  id                  String             @id @default(cuid())
  restaurantId         String             @unique
  plan                String             @default("starter")
  status              SubscriptionStatus @default(FREE)
  paystackCustomerCode String?
  paystackSubscriptionCode String?
  currentPeriodEnd    DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Order {
  id                   String      @id @default(cuid())
  restaurantId         String
  conversationId       String?
  customerName         String?
  customerPhone        String
  deliveryAddress      String?
  deliveryFee          Int         @default(0)
  notes                String?
  internalNotes        String?
  totalAmount          Int         @default(0)
  status               OrderStatus @default(NEW)
  assignedTeamMemberId String?
  isDemo               Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  restaurant         Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  conversation       Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedTeamMember TeamMember?   @relation("OrderAssignments", fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)
  items              OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  name      String
  quantity  Int      @default(1)
  price     Int      @default(0)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DeliveryZone {
  id            String   @id @default(cuid())
  restaurantId  String
  area          String
  fee           Int      @default(0)
  estimatedTime String?
  active        Boolean  @default(true)
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model KnowledgeBaseItem {
  id           String   @id @default(cuid())
  restaurantId String
  title        String
  content      String
  category     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model CustomerMemory {
  id            String   @id @default(cuid())
  restaurantId  String
  customerPhone String
  key           String
  value         String
  confidence    Int      @default(70)
  source        String
  reviewStatus  String   @default("APPROVED")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, customerPhone])
  @@index([restaurantId, active])
  @@index([restaurantId, reviewStatus])
}

model CustomerLoyalty {
  id            String   @id @default(cuid())
  restaurantId  String
  customerPhone String
  customerName  String?
  totalOrders   Int      @default(0)
  totalSpent    Int      @default(0)
  loyaltyTier   String   @default("bronze")
  points        Int      @default(0)
  vip           Boolean  @default(false)
  inactiveRisk  Boolean  @default(false)
  lastOrderAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, customerPhone])
  @@index([restaurantId, loyaltyTier])
  @@index([restaurantId, vip])
  @@index([restaurantId, inactiveRisk])
}

model UpsellRule {
  id               String   @id @default(cuid())
  restaurantId     String
  triggerItem      String
  suggestedItem    String
  message          String
  active           Boolean  @default(true)
  attempts         Int      @default(0)
  acceptedUpsells  Int      @default(0)
  revenueGenerated Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  upsellAttempts UpsellAttempt[]

  @@index([restaurantId, active])
}

model UpsellAttempt {
  id               String    @id @default(cuid())
  restaurantId     String
  upsellRuleId     String
  conversationId   String?
  customerPhone    String
  triggerItem      String
  suggestedItem    String
  accepted         Boolean   @default(false)
  revenueGenerated Int       @default(0)
  createdAt        DateTime  @default(now())
  acceptedAt       DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  upsellRule UpsellRule @relation(fields: [upsellRuleId], references: [id], onDelete: Cascade)

  @@index([restaurantId, customerPhone])
  @@index([restaurantId, conversationId])
  @@index([upsellRuleId, createdAt])
}

model ComplaintAlert {
  id             String   @id @default(cuid())
  restaurantId   String
  conversationId String
  severity       String
  reason         String
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([restaurantId, resolved])
  @@index([conversationId, resolved])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventType String
  reference String?  @unique
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AIUsageLog {
  id             String      @id @default(cuid())
  restaurantId   String
  conversationId String?
  eventType      AIEventType
  model          String
  promptTokens   Int         @default(0)
  outputTokens   Int         @default(0)
  totalTokens    Int         @default(0)
  estimatedCost  Float       @default(0)
  inputPreview   String?
  outputPreview  String?
  blockedReason  String?
  createdAt      DateTime    @default(now())

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
}

model MediaGeneration {
  id           String   @id @default(cuid())
  restaurantId String
  campaignId   String?
  prompt       String
  model        String
  outputUrl    String?
  status       String   @default("COMPLETED")
  estimatedCost Float   @default(0)
  templateType String?
  favorite     Boolean  @default(false)
  caption      String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  campaign   PromoCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model PromoCampaign {
  id           String              @id @default(cuid())
  restaurantId String
  title        String
  description  String?
  goal         String?
  status       PromoCampaignStatus @default(DRAFT)
  startDate    DateTime?
  endDate      DateTime?
  impressions       Int     @default(0)
  whatsappInquiries Int     @default(0)
  ordersGenerated   Int     @default(0)
  revenueGenerated  Int     @default(0)
  performanceNotes  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  restaurant Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  media      MediaGeneration[]
  captionPacks CampaignCaptionPack[]
  posts      CampaignPost[]
}

model CampaignCaptionPack {
  id             String   @id @default(cuid())
  campaignId     String
  whatsappStatus String?
  instagramPost  String?
  facebookPost   String?
  hashtags       String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignPost {
  id          String   @id @default(cuid())
  campaignId  String
  assignedTeamMemberId String?
  socialAccountId String?
  title       String
  platform    String
  scheduledAt DateTime
  posted      Boolean  @default(false)
  autoPostEnabled Boolean @default(false)
  autoPostPaused Boolean @default(false)
  autoPostStatus String @default("MANUAL")
  autoPostAttempts Int @default(0)
  autoPostError String?
  autoPostedAt DateTime?
  socialPostUrl String?
  completionNotes String?
  postedAt    DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignedTeamMember TeamMember? @relation("CampaignPostAssignments", fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
}

model SocialAccount {
  id          String   @id @default(cuid())
  restaurantId String
  provider    String
  displayName String
  accountHandle String?
  permissions String[] @default([])
  postingEnabled Boolean @default(false)
  paused Boolean @default(false)
  status String @default("CONNECTED")
  connectionNote String?
  lastConnectedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  campaignPosts CampaignPost[]
}

model ReportArchive {
  id            String            @id @default(cuid())
  restaurantId  String
  type          ReportArchiveType
  title         String
  periodStart   DateTime
  periodEnd     DateTime
  messages      Int               @default(0)
  orders        Int               @default(0)
  revenue       Int               @default(0)
  campaignPosts Int               @default(0)
  missedPosts   Int               @default(0)
  aiEvents      Int               @default(0)
  mediaAssets   Int               @default(0)
  summaryNote   String?
  createdAt     DateTime          @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model BusinessInsight {
  id             String   @id @default(cuid())
  restaurantId   String
  period         String
  category       String
  title          String
  summary        String
  recommendation String
  metricLabel    String?
  metricValue    String?
  priority       String   @default("medium")
  createdAt      DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, period])
  @@index([restaurantId, category])
  @@index([restaurantId, createdAt])
}

model PilotClient {
  id           String      @id @default(cuid())
  restaurantId String
  businessName String
  contactName  String?
  phone        String
  email        String?
  instagram    String?
  businessType String?
  location     String?
  notes        String?
  status       PilotStatus @default(NEW)
  lastContactedAt DateTime?
  nextContactAt   DateTime?
  followUpNotes   String?
  goLiveApproved   Boolean   @default(false)
  goLiveApprovedAt DateTime?
  goLiveNotes      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  checklist  PilotChecklistItem[]
  tests      PilotTest[]
}

model PilotChecklistItem {
  id        String   @id @default(cuid())
  pilotId   String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilot PilotClient @relation(fields: [pilotId], references: [id], onDelete: Cascade)
}

model PilotTest {
  id          String          @id @default(cuid())
  pilotId     String
  title       String
  description String?
  status      PilotTestStatus @default(NOT_STARTED)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  pilot PilotClient @relation(fields: [pilotId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id           String   @id @default(cuid())
  restaurantId String
  name         String?
  email        String
  role         TeamRole @default(AGENT)
  invited      Boolean  @default(true)
  accepted     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant            Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[] @relation("ConversationAssignments")
  assignedOrders        Order[]        @relation("OrderAssignments")
  assignedCampaignPosts CampaignPost[] @relation("CampaignPostAssignments")

  @@unique([restaurantId, email])
}
