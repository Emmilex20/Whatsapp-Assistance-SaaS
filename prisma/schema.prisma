generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum AutomationStatus {
  ACTIVE
  DRAFT
  PAUSED
}

enum SenderType {
  CUSTOMER
  BOT
  HUMAN
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum PilotStatus {
  NEW
  CONTACTED
  SETUP_IN_PROGRESS
  LIVE_TESTING
  ACTIVE
  NOT_INTERESTED
}

enum TeamRole {
  OWNER
  MANAGER
  AGENT
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ConversationWorkflowStatus {
  OPEN
  PENDING
  RESOLVED
}

model User {
  id                 String   @id @default(cuid())
  clerkId            String   @unique
  email              String   @unique
  name               String?
  activeRestaurantId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  restaurants Restaurant[]
}

model Restaurant {
  id                    String   @id @default(cuid())
  ownerId               String
  name                  String
  whatsappNumber        String?
  whatsappPhoneNumberId String?
  address               String?
  openingTime           String?
  closingTime           String?
  aiAutoReplyEnabled    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  menuItems     MenuItem[]
  faqs          FAQ[]
  automations   Automation[]
  conversations Conversation[]
  deliveryZones DeliveryZone[]
  orders        Order[]
  subscription  Subscription?
  pilotClients  PilotClient[]
  teamMembers   TeamMember[]
  knowledgeBaseItems KnowledgeBaseItem[]
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  category     String?
  price        Int
  available    Boolean  @default(true)
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model FAQ {
  id           String   @id @default(cuid())
  restaurantId String
  question     String
  answer       String
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Automation {
  id           String           @id @default(cuid())
  restaurantId String
  name         String
  triggers     String[]
  response     String
  status       AutomationStatus @default(ACTIVE)
  usedCount    Int              @default(0)
  isDemo       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Conversation {
  id                   String   @id @default(cuid())
  restaurantId         String
  customerName         String?
  customerPhone        String
  status               String   @default("BOT_ACTIVE")
  priority             ConversationPriority @default(NORMAL)
  tags                 String[] @default([])
  workflowStatus       ConversationWorkflowStatus @default(OPEN)
  resolvedAt           DateTime?
  assignedTeamMemberId String?
  internalNotes        String?
  isDemo               Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  restaurant         Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignedTeamMember TeamMember? @relation("ConversationAssignments", fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)
  messages           Message[]
  orders             Order[]

  @@unique([restaurantId, customerPhone])
}

model Message {
  id             String     @id @default(cuid())
  conversationId String
  senderType     SenderType
  content        String
  isDemo         Boolean    @default(false)
  createdAt      DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                  String             @id @default(cuid())
  restaurantId         String             @unique
  plan                String             @default("starter")
  status              SubscriptionStatus @default(FREE)
  paystackCustomerCode String?
  paystackSubscriptionCode String?
  currentPeriodEnd    DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Order {
  id                   String      @id @default(cuid())
  restaurantId         String
  conversationId       String?
  customerName         String?
  customerPhone        String
  deliveryAddress      String?
  deliveryFee          Int         @default(0)
  notes                String?
  internalNotes        String?
  totalAmount          Int         @default(0)
  status               OrderStatus @default(NEW)
  assignedTeamMemberId String?
  isDemo               Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  restaurant         Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  conversation       Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedTeamMember TeamMember?   @relation("OrderAssignments", fields: [assignedTeamMemberId], references: [id], onDelete: SetNull)
  items              OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  name      String
  quantity  Int      @default(1)
  price     Int      @default(0)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DeliveryZone {
  id            String   @id @default(cuid())
  restaurantId  String
  area          String
  fee           Int      @default(0)
  estimatedTime String?
  active        Boolean  @default(true)
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model KnowledgeBaseItem {
  id           String   @id @default(cuid())
  restaurantId String
  title        String
  content      String
  category     String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventType String
  reference String?  @unique
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PilotClient {
  id           String      @id @default(cuid())
  restaurantId String
  businessName String
  contactName  String?
  phone        String
  email        String?
  instagram    String?
  businessType String?
  location     String?
  notes        String?
  status       PilotStatus @default(NEW)
  lastContactedAt DateTime?
  nextContactAt   DateTime?
  followUpNotes   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  checklist  PilotChecklistItem[]
}

model PilotChecklistItem {
  id        String   @id @default(cuid())
  pilotId   String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilot PilotClient @relation(fields: [pilotId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id           String   @id @default(cuid())
  restaurantId String
  name         String?
  email        String
  role         TeamRole @default(AGENT)
  invited      Boolean  @default(true)
  accepted     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant            Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[] @relation("ConversationAssignments")
  assignedOrders        Order[]        @relation("OrderAssignments")

  @@unique([restaurantId, email])
}
